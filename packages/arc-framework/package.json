{
  "name": "@arc-framework/cli",
  "version": "0.0.0",
  "description": "CLI tool for installing, updating, and managing ARC framework files",
  "type": "module",
  "bin": {
    "arc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && vitest run -c vitest.e2e.config.ts",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:ts": "eslint src/",
    "lint:sh": "shellcheck -x --source-path=SCRIPTDIR arc/system/githooks/pre-commit arc/system/githooks/commit-msg arc/system/scripts/*.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^13.1.0",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.7.1",
    "eslint": "^10.1.0",
    "shellcheck": "^4.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.0.8"
  },
  "files": [
    "dist",
    "arc",
    "templates",
    "init-recipe.json"
  ],
  "keywords": [
    "arc",
    "framework",
    "cli",
    "ai",
    "development",
    "methodology"
  ],
  "license": "MIT"
}
