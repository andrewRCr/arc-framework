{
  "name": "@arc-framework/cli",
  "version": "0.1.0",
  "description": "CLI tool for installing, updating, and managing ARC framework files",
  "type": "module",
  "bin": {
    "arc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "benchmark:session-envelope": "npm run build && tsx __tests__/benchmarks/session-envelope-validation.ts",
    "inventory:command-inputs": "tsx src/scripts/render-command-input-inventory.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project unit-mocks",
    "test:integration": "vitest run --project integration",
    "test:arc-contracts": "vitest run --project integration framework-sync pr-open-extensions review-gate-workflows",
    "test:e2e": "vitest run --project e2e",
    "test:portability": "vitest run user-sync-notes-lock ref-tree-cas state-ref-race.e2e git-executor",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "lint:ts": "eslint src/ __tests__/",
    "lint:sh": "bash arc/system/.internal/scripts/run-shellcheck.sh arc/system/.internal/githooks/pre-commit arc/system/.internal/githooks/commit-msg arc/system/.internal/githooks/pre-push arc/system/.internal/scripts/*.sh ../../scripts/*.sh"
  },
  "engines": {
    "node": ">=24",
    "git": ">=2.31"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^15.0.0",
    "execa": "^10.0.0",
    "js-yaml": "^4.2.0",
    "neverthrow": "^8.2.0",
    "semver": "^7.7.4",
    "string-width": "8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/semver": "^7.7.1",
    "eslint": "^10.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist",
    "arc",
    "templates",
    "init-recipe.json",
    "changelog"
  ],
  "keywords": [
    "arc",
    "framework",
    "cli",
    "ai",
    "development",
    "methodology"
  ],
  "author": "Andrew Creekmore",
  "license": "Apache-2.0",
  "homepage": "https://github.com/andrewRCr/arc-framework#readme",
  "bugs": {
    "url": "https://github.com/andrewRCr/arc-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewRCr/arc-framework.git",
    "directory": "packages/arc-framework"
  }
}
