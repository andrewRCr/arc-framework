{
  "name": "@arc-framework/cli",
  "version": "0.1.0",
  "description": "CLI tool for installing, updating, and managing ARC framework files",
  "type": "module",
  "bin": {
    "arc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run && vitest run -c vitest.e2e.config.ts",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "lint:ts": "eslint src/ __tests__/",
    "lint:sh": "bash arc/system/.internal/scripts/run-shellcheck.sh arc/system/.internal/githooks/pre-commit arc/system/.internal/githooks/commit-msg arc/system/.internal/scripts/*.sh"
  },
  "engines": {
    "node": ">=24",
    "git": ">=2.28"
  },
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "^13.1.0",
    "js-yaml": "^4.1.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/semver": "^7.7.1",
    "eslint": "^10.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.0.8"
  },
  "files": [
    "dist",
    "arc",
    "templates",
    "init-recipe.json",
    "changelog"
  ],
  "keywords": [
    "arc",
    "framework",
    "cli",
    "ai",
    "development",
    "methodology"
  ],
  "author": "Andrew Creekmore",
  "license": "Apache-2.0",
  "homepage": "https://github.com/andrewRCr/arc-framework#readme",
  "bugs": {
    "url": "https://github.com/andrewRCr/arc-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewRCr/arc-framework.git",
    "directory": "packages/arc-framework"
  }
}
