{
  "include_files": [
    "reference/QUICK-REFERENCE.template.md",
    "reference/META-PRD.template.md",
    "reference/TECHNICAL-OVERVIEW.template.md",
    "active/WORK-STATUS.template.md",
    "system/agent/AGENTS.template.md",
    "system/arc-config.yml",
    "system/workflows/arc/session-lifecycle/session-init.md",
    "system/workflows/arc/3_process-task-loop.md",
    "system/workflows/arc/1_create-prd.md",
    "system/workflows/arc/2_generate-tasks.md",
    "system/workflows/arc-methods.md",
    "system/workflows/arc-extensions.md",
    "system/skills/arc-resume/SKILL.md",
    "system/skills/arc-commit/SKILL.md",
    "system/skills/arc-handoff/SKILL.md",
    "system/skills/README.md",
    "system/githooks/commit-msg",
    "system/githooks/pre-commit",
    "system/githooks/README.md",
    "reference/constitution/DEV-RULES.ARC.md",
    "reference/constitution/DEV-RULES.PROJECT.md",
    "reference/strategies/STRATEGY-INDEX.md",
    "reference/strategies/arc/strategy-adr-methodology.md",
    "reference/strategies/arc/strategy-agent-hooks.md",
    "reference/strategies/arc/strategy-configurability-architecture.md",
    "reference/strategies/arc/strategy-context-loading.md",
    "reference/strategies/arc/strategy-core-philosophy.md",
    "reference/strategies/arc/strategy-file-classification.md",
    "reference/strategies/arc/strategy-quality-gates.md",
    "reference/strategies/arc/strategy-session-management.md",
    "reference/strategies/arc/strategy-task-list-formatting.md",
    "reference/strategies/arc/strategy-team-coordination.md",
    "reference/strategies/arc/strategy-work-organization.md",
    "reference/strategies/arc/strategy-work-planning.md",
    "reference/strategies/project/README.md"
  ],
  "computed_tokens": {
    "REPO_ROOT": "Auto-detected from working directory at init time"
  },
  "prompts": [
    {
      "id": "project_name",
      "type": "text",
      "message": "Project name?",
      "token": "PROJECT_NAME"
    },
    {
      "id": "project_description",
      "type": "text",
      "message": "Brief project description (one sentence):",
      "token": "PROJECT_DESCRIPTION"
    },
    {
      "id": "base_branch",
      "type": "text",
      "message": "Base branch name?",
      "default": "main",
      "config_key": "branch.base"
    },
    {
      "id": "branch_protection",
      "type": "select",
      "message": "Branch protection level?",
      "options": ["partial", "full"],
      "default": "partial",
      "config_key": "branch.protection"
    },
    {
      "id": "pm_mode",
      "type": "select",
      "message": "Where does your project management live?",
      "options": ["none", "arc-in-git", "external"],
      "default": "none",
      "config_key": "pm.mode"
    },
    {
      "id": "team_mode",
      "type": "confirm",
      "message": "Enable team mode (multiple developers)?",
      "default": false,
      "config_key": "team.mode"
    },
    {
      "id": "merge_strategy",
      "type": "select",
      "message": "How should branches be merged?",
      "options": ["merge", "rebase", "squash"],
      "default": "merge",
      "config_key": "merge.strategy"
    },
    {
      "id": "platform",
      "type": "select",
      "message": "Git hosting platform?",
      "options": ["github", "gitlab", "bitbucket", "azure-devops"],
      "default": "github",
      "config_key": "platform.type"
    },
    {
      "id": "agents",
      "type": "multiselect",
      "message": "Which AI agents will you use?",
      "options": ["claude", "codex", "gemini", "copilot", "cursor", "windsurf", "warp"]
    },
    {
      "id": "arc_dir",
      "type": "text",
      "message": "Install directory?",
      "default": ".arc",
      "token": "ARC_DIR"
    }
  ],
  "conditions": {
    "pm.mode == arc-in-git": {
      "include_files": [
        "backlog/ROADMAP.template.md",
        "backlog/feature/BACKLOG-FEATURE.template.md",
        "backlog/technical/BACKLOG-TECHNICAL.template.md",
        "reference/PROJECT-STATUS.template.md",
        "reference/strategies/arc/strategy-backlog-organization.md"
      ]
    },
    "agents includes claude": {
      "include_files": [
        "system/agent/CLAUDE.template.md"
      ]
    },
    "agents includes codex": {
      "include_files": [
        "system/agent/CODEX.template.md"
      ]
    },
    "agents includes gemini": {
      "include_files": [
        "system/agent/GEMINI.template.md"
      ]
    },
    "agents includes copilot": {
      "include_files": [
        "system/agent/copilot-instructions.template.md"
      ]
    },
    "agents includes cursor": {
      "include_files": [
        "system/agent/CURSOR.template.md"
      ]
    },
    "agents includes windsurf": {
      "include_files": [
        "system/agent/WINDSURF.template.md"
      ]
    },
    "agents includes warp": {
      "include_files": [
        "system/agent/WARP.template.md"
      ]
    }
  }
}
