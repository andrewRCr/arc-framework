  "prompts": [
    {
      "id": "project_name",
      "type": "text",
      "message": "Project name?",
      "token": "PROJECT_NAME"
    },
    {
      "id": "tools",
      "type": "multiselect",
      "message": "Which AI development tools do you use?",
      "options": [
        "amp", "cline", "codex", "cursor", "gemini", "copilot", "kimi", "opencode", "warp", "windsurf",
        "antigravity", "augment", "claude"
      ]
    },
    {
      "id": "pm_mode",
      "type": "select",
      "message": "Project management approach?",
      "options": ["none", "arc-in-git", "external"],
      "default": "none",
      "config_key": "pm.mode"
    },
    {
      "id": "team_mode",
      "type": "confirm",
      "message": "Will other developers work in this repository?",
      "default": false,
      "config_key": "team.mode"
    }
  ],
  "conditions": {
    "pm.mode == external": {
      "include_files": [
        "system/workflows/arc/initial-setup/03_configure-external-integration.md"
      ]
    },
    "pm.mode == arc-in-git": {
      "include_files": [
        "backlog/ROADMAP.template.md",
        "backlog/ATOMIC-INBOX.template.md",
        "completed/README.md",
        "reference/strategies/arc/strategy-planning-module.md"
      ]
    },
    "team.mode == true": {
      "include_files": [
        "reference/strategies/arc/strategy-team-coordination.md"
      ]
    }
  }
}
