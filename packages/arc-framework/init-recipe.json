    "user/README.md"
  ],
  "computed_tokens": {
    "REPO_ROOT": "Auto-detected from working directory at init time"
  },
  "prompts": [
    {
      "id": "project_name",
      "type": "text",
      "message": "Project name?",
      "token": "PROJECT_NAME"
    },
    {
      "id": "tools",
      "type": "multiselect",
      "message": "Which AI development tools do you use?",
      "options": [
        "amp", "cline", "codex", "cursor", "gemini", "copilot", "kimi", "opencode", "warp", "windsurf",
        "antigravity", "augment", "claude"
      ]
    },
    {
      "id": "pm_mode",
      "type": "select",
      "message": "Project management approach?",
      "options": ["none", "arc-in-git", "external"],
      "default": "none",
      "config_key": "pm.mode"
    },
    {
      "id": "team_mode",
      "type": "confirm",
      "message": "Will other developers work in this repository?",
      "default": false,
      "config_key": "team.mode"
    }
  ],
  "conditions": {
    "pm.mode == external": {
      "include_files": [
        "system/workflows/arc/initial-setup/03_configure-external-integration.md"
      ]
    },
    "pm.mode == arc-in-git": {
      "include_files": [
        "backlog/ROADMAP.template.md",
        "backlog/feature/BACKLOG-FEATURE.template.md",
        "backlog/technical/BACKLOG-TECHNICAL.template.md",
        "reference/PROJECT-STATUS.template.md",
        "reference/strategies/arc/strategy-backlog-organization.md"
      ]
    },
    "tools includes claude": {
      "include_files": [
        "system/agent/CLAUDE.ARC.md"
      ]
    },
    "tools includes codex": {
      "include_files": [
        "system/agent/CODEX.ARC.md"
      ]
    },
    "tools includes gemini": {
      "include_files": [
        "system/agent/GEMINI.ARC.md"
      ]
    },
    "tools includes copilot": {
      "include_files": [
        "system/agent/COPILOT.ARC.md"
      ]
    },
    "tools includes cursor": {
      "include_files": [
        "system/agent/CURSOR.ARC.md"
      ]
    },
    "tools includes windsurf": {
      "include_files": [
        "system/agent/WINDSURF.ARC.md"
      ]
    },
    "tools includes warp": {
      "include_files": [
        "system/agent/WARP.ARC.md"
      ]
    }
  }
}
