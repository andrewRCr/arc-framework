#!/bin/bash
# Git commit-msg hook - gates exemptions and delegates validation to the ARC CLI.
# Location: .arc/system/.internal/githooks/commit-msg
#
# Setup: git config core.hooksPath .arc/system/.internal/githooks
# NOTE: Never use --no-verify to bypass hooks. Fix the issue instead.

set -e

# Source shared library for the framework config reader.
. "$(dirname "$0")/../scripts/arc-lib.sh"

hook_enabled=$(arc_config_get "hooks.commit_msg" "enabled")
if [ "$hook_enabled" = "disabled" ]; then
    exit 0
fi

# Git's generated merge messages are exempt from commit-message policy.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
    exit 0
fi

if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
    echo "error: ARC commit-message validation could not resolve the Git repository root." >&2
    exit 1
fi

local_arc="$repo_root/node_modules/.bin/arc"
if [ -x "$local_arc" ]; then
    exec "$local_arc" check commit-msg "$1"
fi

if command -v arc >/dev/null 2>&1; then
    exec arc check commit-msg "$1"
fi

cat >&2 <<EOF
error: ARC commit-message validation is enabled, but the ARC CLI could not be resolved.

Expected repository-local executable:
  $local_arc

Install @arc-framework/cli in this repository, or install it globally and make
the global arc executable available in non-interactive shells. GUI Git clients
and IDE-integrated commits often use a restricted PATH; version manager shims
must also be initialized for that environment.
EOF
exit 1

