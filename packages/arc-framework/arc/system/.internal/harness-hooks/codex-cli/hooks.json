{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.arc/system/.internal/harness-hooks/common/pre-compact-seed.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\pre-compact-seed.mjs\"",
            "timeout": 30,
            "statusMessage": "Writing ARC compaction seed"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.arc/system/.internal/harness-hooks/common/post-compact-recover.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\post-compact-recover.mjs\"",
            "timeout": 30,
            "statusMessage": "Stopping for ARC recovery"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.arc/system/.internal/harness-hooks/common/user-prompt-recover.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\user-prompt-recover.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
