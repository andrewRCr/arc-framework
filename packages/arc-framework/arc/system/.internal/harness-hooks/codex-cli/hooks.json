{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && cd \"$repo_root\" && ARC_HOOK_HARNESS=codex-cli node \"$repo_root/.arc/system/.internal/harness-hooks/common/pre-compact-seed.mjs\" || exit 0",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do (cd /d \"%i\" && set \"ARC_HOOK_HARNESS=codex-cli\" && node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\pre-compact-seed.mjs\") || exit /b 0",
            "timeout": 30,
            "statusMessage": "Writing ARC compaction seed"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.arc/system/.internal/harness-hooks/common/post-tool-use-recover.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\post-tool-use-recover.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && node \"$repo_root/.arc/system/.internal/harness-hooks/common/clear-codex-recovery-pending.mjs\" || exit 0",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\clear-codex-recovery-pending.mjs\" || exit /b 0",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.arc/system/.internal/harness-hooks/common/user-prompt-recover.mjs\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do node \"%i\\.arc\\system\\.internal\\harness-hooks\\common\\user-prompt-recover.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
