#!/bin/bash
# Git commit-msg hook - Validates commit message format
# Location: .arc-internal/system/githooks/commit-msg
#
# Internal variant:
#   - Reads config from .arc-internal/system/arc-config.yml
#   - Searches both .arc/ and .arc-internal/ active directories
#
# Setup: git config core.hooksPath .arc-internal/system/githooks
# NOTE: Never use --no-verify to bypass hooks. Fix the issue instead.

set -e

# Source shared library (config reader, colors)
. "$(dirname "$0")/../scripts/arc-lib.sh"

# Override config path for internal workspace
ARC_CONFIG_FILE=".arc-internal/system/arc-config.yml"

# Convenience aliases for color variables
RED="$ARC_RED"
YELLOW="$ARC_YELLOW"
GREEN="$ARC_GREEN"
NC="$ARC_NC"

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

hook_enabled=$(arc_config_get "hooks.commit_msg" "enabled")
commit_format=$(arc_config_get "commit.format" "conventional")
context_footer_mode=$(arc_config_get "commit.context_footer" "required")
custom_pattern=$(arc_config_get "commit.custom_pattern" "")
context_pattern=$(arc_config_get "commit.context_pattern" "")

# Exit early if hook is disabled
if [ "$hook_enabled" = "disabled" ]; then
    exit 0
fi

# Extract components
subject=$(echo "$commit_msg" | head -n1)
subject_length=${#subject}
body=$(echo "$commit_msg" | tail -n +3) # Skip subject and blank line

errors=0
warnings=0

# Helper: report context footer issue — severity depends on config
# required → error (blocks commit), recommended → warning (advisory)
context_issue() {
    local message="$1"
    if [ "$context_footer_mode" = "recommended" ]; then
        echo -e "${YELLOW}Warning: ${message}${NC}"
        warnings=$((warnings + 1))
    else
        echo -e "${RED}Error: ${message}${NC}"
        errors=$((errors + 1))
    fi
}

echo -e "${GREEN}Validating commit message...${NC}"

# ============================================================================
# RULE 1: Commit Format Validation (config-aware)
# ============================================================================
# Behavior determined by commit.format setting in arc-config.yml:
#   conventional - type(scope): description (default)
#   custom       - validates against commit.custom_pattern regex
#   any          - no format validation
case "$commit_format" in
    conventional)
        if ! echo "$subject" | grep -qE '^(feat|fix|docs|style|refactor|content|test|chore|perf|build|ci|config|revert)\([a-z][a-z0-9-]*\): .+'; then
            echo -e "${RED}Error: Subject must follow Conventional Commits format${NC}"
            echo "   Expected: <type>(scope): description"
            echo "   Types: feat, fix, docs, content, style, refactor, test, chore, perf, build, ci, config, revert"
            echo "   Example: feat(auth): add JWT token refresh endpoint"
            echo ""
            echo "   Your subject: $subject"
            errors=$((errors + 1))
        fi
        ;;
    custom)
        if [ -z "$custom_pattern" ]; then
            echo -e "${RED}Error: commit.format is 'custom' but commit.custom_pattern is empty${NC}"
            echo "   Set commit.custom_pattern in arc-config.yml"
            errors=$((errors + 1))
        elif ! echo "$subject" | grep -qE "$custom_pattern"; then
            echo -e "${RED}Error: Subject does not match custom format pattern${NC}"
            echo "   Pattern: $custom_pattern"
            echo "   Your subject: $subject"
            errors=$((errors + 1))
        fi
        ;;
    any)
        # No format validation
        ;;
esac

# ============================================================================
# RULE 2: Subject Line Length (max 72, warn at 60)
# Git's traditional 50-char guideline assumes plain subjects. Conventional
# commit prefixes (type(scope): ) consume 8-15 chars, so we warn at 60.
# ============================================================================
if [ "$subject_length" -lt 10 ]; then
    echo -e "${RED}Error: Subject line too short (${subject_length} chars, minimum 10)${NC}"
    errors=$((errors + 1))
elif [ "$subject_length" -gt 72 ]; then
    echo -e "${RED}Error: Subject line too long (${subject_length} chars, maximum 72)${NC}"
    errors=$((errors + 1))
elif [ "$subject_length" -gt 60 ]; then
    echo -e "${YELLOW}Warning: Subject line is ${subject_length} chars (recommended max 60, hard limit 72)${NC}"
    warnings=$((warnings + 1))
fi

# ============================================================================
# RULE 3: Context Footer (config-aware)
# ============================================================================
# Behavior determined by commit.context_footer setting in arc-config.yml:
#   required    - Context: line must be present and valid (default)
#   recommended - warns if missing/invalid, does not block
#   custom      - validates against commit.context_pattern regex
#   disabled    - no context footer validation
case "$context_footer_mode" in
    disabled)
        # No context footer validation
        ;;
    custom)
        if [ -z "$context_pattern" ]; then
            echo -e "${RED}Error: commit.context_footer is 'custom' but commit.context_pattern is empty${NC}"
            echo "   Set commit.context_pattern in arc-config.yml"
            errors=$((errors + 1))
        elif ! echo "$commit_msg" | grep -qE "$context_pattern"; then
            echo -e "${RED}Error: No line matches custom context footer pattern${NC}"
            echo "   Pattern: $context_pattern"
            errors=$((errors + 1))
        fi
        ;;
    required|recommended|*)
        if ! echo "$commit_msg" | grep -qE '^Context: '; then
            context_issue "Missing 'Context:' footer"
            echo "   Every commit should include a Context: line"
            echo ""
            echo "   Examples:"
            echo "   Context: tasks-auth-system.md (Task 3.6)"
            echo "   Context: tasks-api-modernization.md (Tasks 1.4-1.7)"
            echo "   Context: tasks-theme-system.md (Task 2.3.a)"
            echo "   Context: tasks-theme-system.md (Tasks 2.3.c-e)"
            echo "   Context: tasks-theme-system.md (Tasks 6.1.h, 6.2.a-d; maintenance)"
            echo "   Context: tasks-auth-system.md (incidental - discovered during Task 3.6)"
            echo "   Context: tasks-design-system.md (incidental - discovered during code review)"
            echo "   Context: tasks-data-pipeline.md (planning)"
            echo "   Context: tasks-theme-system.md (maintenance)"
            echo "   Context: tasks-structural-pass.md (activation)"
            echo "   Context: tasks-auth-system.md (integration)"
            echo "   Context: tasks-auth-system.md (archival)"
            echo "   Context: atomic-auth-system.md"
            echo "   Context: maintenance (atomic / no associated task list)"
            echo "   Context: refactor (no associated task list)"
            echo "   Context: documentation (atomic / no associated task list)"
            echo "   Context: planning (no associated task list)"
        else
            # Extract Context line for further validation
            context_line=$(echo "$commit_msg" | grep '^Context: ' | head -n1)

            # ================================================================
            # RULE 4: Context Footer Format
            # ================================================================

            # Check for task list reference
            if echo "$context_line" | grep -qE '^Context: tasks-[a-z0-9-]+\.md'; then
                # Task list reference format

                # Extract filename
                task_file=$(echo "$context_line" | sed -E 's/Context: (tasks-[a-z0-9-]+\.md).*/\1/')

                # Check if task list file exists (search active directories)
                task_found=false
                for dir in .arc/active/feature .arc/active/technical .arc/active/incidental \
                           .arc-internal/active/feature .arc-internal/active/technical .arc-internal/active/incidental; do
                    if [ -f "$dir/$task_file" ]; then
                        task_found=true
                        break
                    fi
                done

                if [ "$task_found" = false ]; then
                    echo -e "${YELLOW}Warning: Task list file '$task_file' not found in active directories${NC}"
                    echo "   This may be intentional if the file was just created or archived"
                    warnings=$((warnings + 1))
                fi

                # Validate task reference format
                # Support multi-level task numbering: X.Y, X.Y.a, X.Y.a.1, etc.
                # Level 3 uses letters for readability: 2.3.a, 2.3.b
                # Special case: 'R' (capital) for revised/remedial/remaining work: X.Y.R, X.Y.R.1, X.Y.a.R
                # Ranges can be abbreviated (e.g., 2.3.c-e means 2.3.c-2.3.e)
                # Matches: (Task 2.3), (Task 2.3.a), (Task 2.3.a.1), (Task 2.3.R)
                if echo "$context_line" | grep -qE '\(Task [0-9]+(\.[0-9A-Za-z]+)+\)$'; then
                    :
                # Matches: (Tasks 2.2-2.3), (Tasks 2.3.a-2.3.d), (Tasks 2.3.c-e)
                elif echo "$context_line" | grep -qE '\(Tasks [0-9]+(\.[0-9A-Za-z]+)+-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*\)$'; then
                    :
                # Matches: (Tasks 2.3, 4.5), (Tasks 2.3.a, 4.5.b, 6.7), (Tasks 4.3, 5.1.a-c)
                # Each element can be simple (4.3, 5.1.a) or range (5.1.a-c, 2.3-2.5)
                elif echo "$context_line" | grep -qE '\(Tasks [0-9]+(\.[0-9A-Za-z]+)+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?(, [0-9]+(\.[0-9A-Za-z]+)+(-[0-9A-Za-z]+(\.[0-9A-Za-z]+)*)?)+\)$'; then
                    :
                # Matches: (Task 7.2.c; planning), (Task 2.3.a; maintenance)
                elif echo "$context_line" | grep -qE '\(Task [0-9]+(\.[0-9A-Za-z]+)+; (planning|maintenance)\)$'; then
                    :
                # Matches: (Tasks 6.1.h, 6.2.a-d; maintenance), (Tasks 2.3.a-c; planning)
                elif echo "$context_line" | grep -qE '\(Tasks .+; (planning|maintenance)\)$'; then
                    :
                # Matches: (incidental - discovered during Task 2.3), (incidental - discovered during code review),
                # (incidental - discovered during Phase 5 planning), etc. Freeform context after prefix.
                elif echo "$context_line" | grep -qE '\(incidental - discovered during .+\)$'; then
                    :
                # Matches: (planning), (activation), (maintenance), (archival)
                elif echo "$context_line" | grep -qE '\((planning|activation|integration|maintenance|archival)\)$'; then
                    :
                else
                    context_issue "Invalid task reference format in Context: line"
                    echo "   Expected formats for task list references:"
                    echo "   - (Task X.Y) or (Task X.Y.a) - level 3 uses letters"
                    echo "   - (Task X.Y.a.1) - level 4 if needed"
                    echo "   - (Task X.Y.R) or (Task X.Y.R.1) - 'R' for revised/remedial work"
                    echo "   - (Tasks X.Y-X.Z) or (Tasks X.Y.a-X.Y.d) - task range"
                    echo "   - (Tasks X.Y.c-e) or (Tasks 2.3.c-e) - abbreviated range"
                    echo "   - (Tasks X.Y, A.B, C.D) - non-contiguous tasks"
                    echo "   - (Task X.Y; planning) or (Task X.Y; maintenance) - single task with extra work"
                    echo "   - (Tasks X.Y, A.B; planning) - multiple tasks with extra work"
                    echo "   - (incidental - discovered during <context>) - freeform discovery context"
                    echo "   - (planning), (activation), (integration), (maintenance), or (archival) - task list lifecycle"
                    echo ""
                    echo "   Note: Parenthetical is REQUIRED for all commits"
                    echo ""
                    echo "   Your Context line: $context_line"
                fi

            # Matches: Context: atomic-[name].md (work-unit-scoped atomic task)
            elif echo "$context_line" | grep -qE '^Context: atomic-[a-z0-9-]+\.md$'; then
                # Atomic companion file reference — valid, no task number needed
                atomic_file=$(echo "$context_line" | sed -E 's/Context: (atomic-[a-z0-9-]+\.md).*/\1/')

                # Check if atomic companion file exists (search active directories)
                atomic_found=false
                for dir in .arc/active/feature .arc/active/technical .arc/active/incidental \
                           .arc-internal/active/feature .arc-internal/active/technical .arc-internal/active/incidental; do
                    if [ -f "$dir/$atomic_file" ]; then
                        atomic_found=true
                        break
                    fi
                done

                if [ "$atomic_found" = false ]; then
                    echo -e "${YELLOW}Warning: Atomic companion file '$atomic_file' not found in active directories${NC}"
                    echo "   This may be intentional if the file was just created or archived"
                    warnings=$((warnings + 1))
                fi

            # Matches: Context: planning (no associated task list), Context: maintenance (atomic / no associated task list)
            elif echo "$context_line" | grep -qE '^Context: (planning|documentation|maintenance|refactor|content) \((atomic / )?no associated task list\)$'; then
                :
            else
                context_issue "Invalid Context: format"
                echo "   Expected formats:"
                echo "   - Context: tasks-[name].md (Task X.Y)"
                echo "   - Context: tasks-[name].md (Tasks X.Y-X.Z)"
                echo "   - Context: tasks-[name].md (incidental - discovered during <context>)"
                echo "   - Context: tasks-[name].md (planning), (activation), (integration), (maintenance), or (archival)"
                echo "   - Context: atomic-[name].md"
                echo "   - Context: [category] (no associated task list)"
                echo "   - Context: [category] (atomic / no associated task list)"
                echo ""
                echo "   Categories: planning, documentation, maintenance, refactor, content"
                echo "   Note: Parenthetical is REQUIRED for all commits"
                echo ""
                echo "   Your Context line: $context_line"
            fi
        fi
        ;;
esac

# ============================================================================
# RULE 5: Body Length Limits (warnings only)
# ============================================================================
body_lines=$(echo "$body" | grep -v '^$' | wc -l)

if [ "$body_lines" -gt 25 ]; then
    echo -e "${YELLOW}Warning: Commit body is ${body_lines} lines (maximum 25 recommended)${NC}"
    echo "   Consider breaking into multiple commits or reducing verbosity"
    warnings=$((warnings + 1))
elif [ "$body_lines" -gt 15 ]; then
    echo -e "${YELLOW}Info: Commit body is ${body_lines} lines (normal limit 15, milestone limit 25)${NC}"
fi

# ============================================================================
# RULE 6: Common Mistakes
# ============================================================================

# Check for "Phase X.Y" instead of "Task X.Y"
if echo "$commit_msg" | grep -qE 'Phase [0-9]+\.[0-9]+'; then
    echo -e "${YELLOW}Warning: Found 'Phase X.Y' in commit message${NC}"
    echo "   Use 'Task X.Y' to reference specific tasks (phases contain tasks)"
    warnings=$((warnings + 1))
fi

# Check for referencing PRD instead of task list
if echo "$commit_msg" | grep -qE 'Related to:.*PRD'; then
    echo -e "${YELLOW}Warning: Found 'Related to: ... PRD' in commit message${NC}"
    echo "   Use 'Context: tasks-[name].md' instead to reference task list"
    warnings=$((warnings + 1))
fi

# ============================================================================
# RULE 7: WORK-STATUS.md freshness (task not advanced)
# ============================================================================
# When committing a completed parent task (Context: "Task X.Y"), verify that
# staged WORK-STATUS.md has been advanced past that task.
# Only checks parent-level tasks (X.Y) — subtask commits (X.Y.z) don't
# advance Current Task, so no warning needed.
# Skipped when context footer is disabled or custom (no ARC context to parse).
if [ "$context_footer_mode" != "disabled" ] && [ "$context_footer_mode" != "custom" ]; then
    context_for_ws=$(echo "$commit_msg" | grep '^Context: ' | head -n1)
    committed_task_num=$(echo "$context_for_ws" | grep -oE '\(Task [0-9]+\.[0-9]+\)$' | grep -oE '[0-9]+\.[0-9]+' || true)

    if [ -n "$committed_task_num" ]; then
        ws_file=$(git diff --cached --name-only | grep -E '^\.(arc|arc-internal)/active/WORK-STATUS\.md$' | head -1 || true)
        if [ -n "$ws_file" ]; then
            ws_current_num=$(git show ":$ws_file" 2>/dev/null | \
                grep -E '^\*\*Current Task\*\*' | \
                grep -oE 'Task [0-9]+\.[0-9]+' | head -1 | \
                grep -oE '[0-9]+\.[0-9]+' || true)
            if [ -n "$ws_current_num" ] && [ "$committed_task_num" = "$ws_current_num" ]; then
                echo -e "${YELLOW}Warning: WORK-STATUS.md may not be advanced${NC}"
                echo "   Context references Task $committed_task_num but WORK-STATUS.md still shows it as Current Task"
                echo "   If this task is complete, advance Current Task to the next task"
                warnings=$((warnings + 1))
            fi
        fi
    fi
fi

# ============================================================================
# Summary
# ============================================================================
echo ""
if [ $errors -gt 0 ]; then
    echo -e "${RED}Commit validation FAILED with $errors error(s) and $warnings warning(s)${NC}"
    echo ""
    echo "Fix the issues above and retry."
    exit 1
elif [ $warnings -gt 0 ]; then
    echo -e "${GREEN}Commit validation PASSED with $warnings warning(s)${NC}"
    exit 0
else
    echo -e "${GREEN}Commit validation PASSED${NC}"
    exit 0
fi
