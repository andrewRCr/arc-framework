#!/bin/bash
# Git pre-commit hook - Runs before commit is created
# Location: .arc/system/.internal/githooks/pre-commit
#
# Setup: git config core.hooksPath .arc/system/.internal/githooks
# NOTE: Never use --no-verify to bypass hooks. Fix the issue instead.
#
# shellcheck disable=SC2001 # sed 's/^/   /' for multiline indentation is clearer than parameter expansion

set -e

# Source shared library (config reader, colors)
. "$(dirname "$0")/../scripts/arc-lib.sh"

# Convenience aliases for color variables
RED="$ARC_RED"
YELLOW="$ARC_YELLOW"
GREEN="$ARC_GREEN"
NC="$ARC_NC"

hook_enabled=$(arc_config_get "hooks.pre_commit" "enabled")
base_branch=$(arc_config_get "branch.base" "main")
branch_protection=$(arc_config_get "branch.protection" "partial")
arc_role=$(git config arc.role 2>/dev/null || echo "maintainer")

# Exit early if hook is disabled
if [ "$hook_enabled" = "disabled" ]; then
    exit 0
fi

echo -e "${GREEN}Running pre-commit checks...${NC}"

# Contributor mode notice (XC-M02) — maintainer-only checks (task list staging,
# task numbering, status file co-staging) are silently skipped for contributors.
if [ "$arc_role" = "contributor" ]; then
    echo "   (contributor mode — maintainer checks skipped)"
fi

errors=0
warnings=0

# ============================================================================
# CHECK 1: Base branch commit protection (config-aware)
# ============================================================================
# Behavior determined by branch_protection setting in arc-config.yml:
#   partial - warning (planned work should use branches)
#   full    - error (all changes require branches and PR review)
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "detached")

if [ "$current_branch" = "detached" ]; then
    echo -e "${YELLOW}Warning: Committing in detached HEAD state${NC}"
    echo "   You are not on a branch — commits may be lost after switching branches"
    warnings=$((warnings + 1))
elif [ "$current_branch" = "$base_branch" ]; then
    case "$branch_protection" in
        full)
            echo -e "${RED}Error: Direct commits to $base_branch blocked (branch_protection: full)${NC}"
            echo "   All changes require a feature branch and PR review"
            echo "   Config: .arc/system/arc-config.yml"
            errors=$((errors + 1))
            ;;
        partial|*)
            echo -e "${YELLOW}Warning: Committing directly to $base_branch branch${NC}"
            echo "   Planned work should use feature/ or technical/ branches"
            echo "   Direct commits OK for: atomic tasks, backlog capture, maintenance"
            warnings=$((warnings + 1))
            ;;
    esac
fi

# ============================================================================
# CHECK 2: Large file check (prevent accidental commits)
# ============================================================================
large_files=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
    size=$(git show ":$file" 2>/dev/null | wc -c || echo 0)
    if [ "$size" -gt 1048576 ]; then  # 1MB
        if command -v numfmt >/dev/null 2>&1; then
            human_size=$(numfmt --to=iec-i --suffix=B "$size" 2>/dev/null || echo "$size bytes")
        else
            human_size="$((size / 1024 / 1024))MiB"
        fi
        echo "$file ($human_size)"
    fi
done)

if [ -n "$large_files" ]; then
    echo -e "${YELLOW}Warning: Large files detected in commit:${NC}"
    echo "$large_files" | sed 's/^/   /'
    echo "   Verify these files should be committed"
    warnings=$((warnings + 1))
fi

# ============================================================================
# CHECK 3: Sensitive file patterns (prevent credential leaks)
# ============================================================================
sensitive_patterns=(
    "\.env$"
    "\.env\.local$"
    "credentials.*\.json"
    "secrets.*\.yaml"
    "private.*\.key"
)

for pattern in "${sensitive_patterns[@]}"; do
    sensitive_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$pattern" || true)
    if [ -n "$sensitive_files" ]; then
        echo -e "${RED}Error: Sensitive file detected: $sensitive_files${NC}"
        echo "   This file pattern matches credentials/secrets"
        echo "   Verify this should be committed (should likely be in .gitignore)"
        errors=$((errors + 1))
    fi
done

# ============================================================================
# CHECK 4: Check for common merge conflict markers
# ============================================================================
# Pre-flight (arc-in-git only): when a merge-like operation leaves
# .arc/backlog/ROADMAP.md as the only conflicted (or marker-bearing) path,
# regenerate from the staged-index projection and restage — regeneration is
# always the correct resolution for this derived file. Wider conflicts fall
# through to the hard error below. Merge-driver install wiring is out of scope
# for this interim hook path.
pm_mode=$(arc_config_get "pm.mode" "none")

if [ "$pm_mode" = "arc-in-git" ]; then
    if ! roadmap_remedy_output=$(npx tsx packages/arc-framework/src/scripts/remedy-roadmap-conflict.ts 2>&1); then
        echo -e "${RED}Error: ROADMAP conflict auto-remedy failed:${NC}"
        echo "$roadmap_remedy_output" | sed 's/^/   /'
        errors=$((errors + 1))
    elif [ -n "$roadmap_remedy_output" ]; then
        echo -e "${GREEN}${roadmap_remedy_output}${NC}"
    fi
fi

conflict_markers=$(git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
    if git show ":$file" 2>/dev/null | grep -qE '^(<<<<<<<|=======|>>>>>>>)'; then
        echo "$file"
    fi
done)

if [ -n "$conflict_markers" ]; then
    echo -e "${RED}Error: Merge conflict markers found in:${NC}"
    echo "$conflict_markers" | sed 's/^/   /'
    echo "   Resolve conflicts before committing"
    errors=$((errors + 1))
fi

# ============================================================================
# CHECK 5: Debug statements check (optional warning)
# ============================================================================
# Adopter: adjust patterns to match your project's languages and debug conventions.
# Default covers JavaScript/TypeScript (console.log, debugger) and Python (pdb, breakpoint).
debug_patterns=(
    "console.log"
    "console.debug"
    "debugger;"
    "import pdb"
    "pdb.set_trace"
    "breakpoint()"
)

debug_test_patterns=$(arc_config_get "hooks.test_patterns" "__tests__/|\.test\.|\.spec\.|/test/|/tests/")

for pattern in "${debug_patterns[@]}"; do
    debug_files=$(git diff --cached --name-only --diff-filter=ACMR | \
        grep -v "^\.arc/" | \
        grep -v "^packages/.*/arc/" | \
        grep -vE "$debug_test_patterns" | \
        while IFS= read -r file; do
        # Check only added lines for debug statements
        if git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' | grep -qF "$pattern"; then
            echo "$file: $pattern"
        fi
    done)

    if [ -n "$debug_files" ]; then
        echo -e "${YELLOW}Warning: Debug statements found in added lines:${NC}"
        echo "$debug_files" | sed 's/^/   /'
        echo "   Consider removing before committing"
        warnings=$((warnings + 1))
        break  # Only warn once
    fi
done

# ============================================================================
# CHECK 6: Contributor protected file warning
# ============================================================================
# When role=contributor, warn if staging files in maintainer-managed directories.
# Soft warning (not a hard block) — contributors may have legitimate reasons.
if [ "$arc_role" = "contributor" ]; then
    contributor_protected_paths=$(arc_config_get "hooks.contributor_protected_paths" "active/|backlog/")
    protected_files=$(git diff --cached --name-only --diff-filter=ACMR | \
        grep -E "^\.arc/($contributor_protected_paths)" || true)

    if [ -n "$protected_files" ]; then
        echo -e "${YELLOW}Warning: Contributor staging maintainer-managed files:${NC}"
        echo "$protected_files" | sed 's/^/   /'
        echo ""
        echo "   Files in .arc/active/ and .arc/backlog/ are typically managed by maintainers"
        echo "   (task lists, work status, backlog items). Contributors usually work on"
        echo "   project code and use 'Context: contribution (...)' commit footers."
        echo "   Config: hooks.contributor_protected_paths in arc-config.yml"
        warnings=$((warnings + 1))
    fi
fi

# ============================================================================
# CHECK 7: Verify modified task lists are staged (maintainer only)
# ============================================================================
# If committing code changes, check if related task lists should also be staged.
# Skipped for contributors — they don't manage task lists.
if [ "$arc_role" != "contributor" ]; then
    modified_task_lists=$(git diff --name-only --diff-filter=M | grep -E '\.arc/active/.*/tasks-.*\.md$' || true)
    staged_task_lists=$(git diff --cached --name-only --diff-filter=M | grep -E '\.arc/active/.*/tasks-.*\.md$' || true)

    if [ -n "$modified_task_lists" ] && [ -z "$staged_task_lists" ]; then
        echo -e "${YELLOW}Warning: Modified task lists not staged:${NC}"
        echo "$modified_task_lists" | sed 's/^/   /'
        echo "   If completing tasks, remember to stage task list updates"
        warnings=$((warnings + 1))
    fi
fi

# ============================================================================
# CHECK 8: Task numbering format (numeric.numeric.alpha) (maintainer only)
# ============================================================================
# Per strategy-task-list-formatting.md: Third level uses letters (1.1.a not 1.1.1)
# Format: X.Y (parent) -> X.Y.a (subtask) -> X.Y.a.1 (fourth level, rare)
# Configurable: hooks.task_numbering = error (default) | warning | off
# Skipped for contributors — they don't author task lists.
task_numbering_mode=$(arc_config_get "hooks.task_numbering" "error")

if [ "$arc_role" != "contributor" ] && [ "$task_numbering_mode" != "off" ]; then
    task_numbering_violations=$(git diff --cached --name-only --diff-filter=ACMR | \
        grep -E '^\.arc/(active|backlog)/.*/tasks-.*\.md$' | \
        while IFS= read -r file; do
            # Look for task lines with numeric third level (wrong: 1.1.1, correct: 1.1.a)
            # Pattern: checkbox followed by optional bold, then three numeric segments
            violations=$(git show ":$file" 2>/dev/null | grep -nE '^\s*- \[[x ]\] \*?\*?[0-9]+\.[0-9]+\.[0-9]+' || true)
            if [ -n "$violations" ]; then
                echo "$file:"
                echo "$violations" | sed 's/^/     /'
            fi
        done)

    if [ -n "$task_numbering_violations" ]; then
        if [ "$task_numbering_mode" = "warning" ]; then
            echo -e "${YELLOW}Warning: Task numbering uses numeric third level (letters recommended):${NC}"
        else
            echo -e "${RED}Error: Invalid task numbering format in task lists:${NC}"
        fi
        echo "$task_numbering_violations"
        echo ""
        echo "   Per strategy-task-list-formatting.md:"
        echo "   - Third level uses letters: 1.1.a, 1.1.b (not 1.1.1, 1.1.2)"
        echo "   - Fourth level (if needed): 1.1.a.1, 1.1.a.2"
        if [ "$task_numbering_mode" = "warning" ]; then
            echo "   Configure: hooks.task_numbering in arc-config.yml"
            warnings=$((warnings + 1))
        else
            errors=$((errors + 1))
        fi
    fi
fi

# ============================================================================
# CHECK 9: No meta-project references in production code
# ============================================================================
# Per DEV-RULES.ARC.md § Documentation Boundaries: code, tests, and durable
# documentation must not reference planning IDs (task X.Y, phase N, requirement
# R-codes, behavior B-codes), spec citations (§ Section), or .arc/ paths.
#
# Tiered patterns:
#   - Strict (all staged code, including tests): patterns rare enough in
#     legitimate fixture data that test exemption is unsafe (PRD R-codes,
#     bare R/B numeric IDs, § citations). PROJECT-PRD lines are filtered as a
#     known false positive (real framework template filename).
#   - Broad (non-test files only): patterns that legitimately appear in test
#     fixtures (Context-footer parsers consume "Context: tasks-foo.md (Task
#     4.2)" strings). The test_patterns exemption preserves those.
skip_extensions=$(arc_config_get "hooks.skip_extensions" "md|yml|yaml|json|toml|txt|csv|lock|conf|cfg|ini|env|license|makefile")
test_patterns=$(arc_config_get "hooks.test_patterns" "__tests__/|\.test\.|\.spec\.|/test/|/tests/")
strict_meta_ref_patterns=$(arc_config_get "hooks.strict_meta_ref_patterns" "PRD R[0-9]+|\b[RB][0-9]+\b|§ ")
meta_ref_patterns=$(arc_config_get "hooks.meta_ref_patterns" "[Tt]ask [0-9]+\.[0-9]+|[Pp]hase [0-9]+|\.arc/|(tasks|plan|prd|status|notes|atomic)-[a-z][a-z0-9-]+\.md")
meta_project_refs=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -v "^\.arc/" | \
    grep -v "^packages/.*/arc/" | \
    grep -v "^README\.md" | \
    grep -vE "(^|/)(\.[a-z]*ignore|\.gitattributes)$" | \
    grep -vE "\.($skip_extensions)$" | \
    while IFS= read -r file; do
        added=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' || true)
        [ -z "$added" ] && continue

        # Strict patterns apply to all staged code. PROJECT-PRD lines excluded.
        strict_refs=$(echo "$added" | grep -nE "$strict_meta_ref_patterns" | grep -v 'PROJECT-PRD' || true)

        # Broad patterns skip test files (legitimate fixture data).
        if echo "$file" | grep -qvE "$test_patterns"; then
            broad_refs=$(echo "$added" | grep -nE "$meta_ref_patterns" || true)
        else
            broad_refs=""
        fi

        combined=$(printf '%s\n%s' "$strict_refs" "$broad_refs" | grep -v '^$' || true)
        if [ -n "$combined" ]; then
            echo "$file:"
            echo "$combined" | sed 's/^/     /'
        fi
    done)

if [ -n "$meta_project_refs" ]; then
    echo -e "${RED}Error: Meta-project references found in production code:${NC}"
    echo "$meta_project_refs"
    echo ""
    echo "   Per DEV-RULES.ARC.md: Code must be self-documenting without task/phase references"
    echo "   Replace with descriptive comments explaining 'what' and 'why' independently"
    errors=$((errors + 1))
fi

# ============================================================================
# CHECK 11: Frontmatter schema validation (methods / extensions)
# ============================================================================
# Delegates to validate-frontmatter.ts via tsx — schema logic lives in
# TypeScript where it is unit-tested; this hook is a thin invoker. Catches
# missing or malformed frontmatter on staged files under system/methods/
# and system/extensions/.
frontmatter_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^(\.arc|packages/arc-framework/arc)/system/(methods|extensions)/' || true)

if [ -n "$frontmatter_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! frontmatter_output=$(npx tsx packages/arc-framework/src/scripts/validate-frontmatter.ts $frontmatter_candidates 2>&1); then
        echo -e "${RED}Error: Frontmatter schema validation failed:${NC}"
        echo "$frontmatter_output" | sed 's/^/   /'
        echo ""
        echo "   Fix the frontmatter in the files listed above."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 12: Domain-rules frontmatter validation (DEV-RULES.{DOMAIN}.md)
# ============================================================================
# Delegates to validate-frontmatter.ts — same validator as CHECK 11, scoped
# to DEV-RULES.{DOMAIN}.md files under system/rules/. Reserved
# filenames (DEV-RULES.ARC.md, DEV-RULES.PROJECT.md) are filtered by the
# validator's classifier and not checked.
domain_rules_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^(\.arc|packages/arc-framework/arc)/system/rules/DEV-RULES\.[^/]+\.md$' || true)

if [ -n "$domain_rules_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! domain_rules_output=$(npx tsx packages/arc-framework/src/scripts/validate-frontmatter.ts $domain_rules_candidates 2>&1); then
        echo -e "${RED}Error: Domain-rules frontmatter validation failed:${NC}"
        echo "$domain_rules_output" | sed 's/^/   /'
        echo ""
        echo "   Fix the frontmatter in the files listed above."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 13: Markdown link resolution (D7a)
# ============================================================================
# Validates that inline and reference-style markdown links in staged .md files
# resolve to existing files. Skips external links, anchor-only links, and
# link-like text inside code spans or fenced code blocks. Relative paths
# resolve from the source file's directory (not cwd).
link_candidates=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.md$' || true)

if [ -n "$link_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! link_output=$(bash "$(dirname "$0")/../scripts/validate-links.sh" $link_candidates 2>&1); then
        echo -e "${RED}Error: Markdown link resolution failed:${NC}"
        echo "$link_output" | sed 's/^/   /'
        echo ""
        echo "   Fix the link targets in the files listed above."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 14: Package-source neutrality (per-file methods / extensions)
# ============================================================================
# Framework package source must ship neutral defaults: per-file methods and
# extensions under packages/arc-framework/arc/system/{methods,extensions}/
# must have `override-active: false` / `active: false` frontmatter and
# `[No override configured]` / `[No extension configured]` placeholder bodies.
# Local customization belongs only in the .arc/ copy — this hook blocks
# personal-repo content from leaking into the package. Complements CHECK 11
# (frontmatter schema) with a semantic gate on values and body content.
neutrality_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^packages/arc-framework/arc/system/(methods|extensions)/[^/]+\.md$' | \
    grep -v '/README\.md$' || true)

if [ -n "$neutrality_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! neutrality_output=$(npx tsx packages/arc-framework/src/scripts/validate-package-neutrality.ts $neutrality_candidates 2>&1); then
        echo -e "${RED}Error: Package-source neutrality check failed:${NC}"
        echo "$neutrality_output" | sed 's/^/   /'
        echo ""
        echo "   Package source must ship neutral defaults. Local customization"
        echo "   (active: true, override-active: true, or populated body sections)"
        echo "   belongs only in the .arc/ copy."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 15: Extension-point reference resolution (D7b)
# ============================================================================
# Every anchor-suffix marker (`· `#<name>``) in a staged workflow file must
# target an existing `system/extensions/<name>.md` in the same copy — .arc/
# workflow resolves against .arc/ extensions; package-source workflow
# resolves against package-source extensions. Complements CHECK 14
# (neutrality on extension bodies) with a gate on workflow references.
# Existence is the pass criterion; `active:` and body content are not
# inspected.
extension_point_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^(\.arc|packages/arc-framework/arc)/system/workflows/.*\.md$' || true)

if [ -n "$extension_point_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! extension_point_output=$(npx tsx packages/arc-framework/src/scripts/validate-extension-points.ts $extension_point_candidates 2>&1); then
        echo -e "${RED}Error: Extension-point reference validation failed:${NC}"
        echo "$extension_point_output" | sed 's/^/   /'
        echo ""
        echo "   Every extension-point marker must target an existing"
        echo "   system/extensions/<name>.md file in the same copy."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 16: Meta-file shape validation
# ============================================================================
# Validates staged lifecycle meta files: managed field-block anchor shape,
# `**Design:**` field shape, lifecycle State enum, and Cohort path shape.
# Tier-aware semantics (per-WU-type Design requirements) are deferred to a
# downstream WU.
meta_spec_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^\.arc/(active(/[^/]+)?|backlog/(planned|provisional)(/.+)?|completed(/.+)?)/meta-[^/]+\.md$' || true)

if [ -n "$meta_spec_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! meta_spec_output=$(npx tsx packages/arc-framework/src/scripts/validate-meta-spec.ts $meta_spec_candidates 2>&1); then
        echo -e "${RED}Error: Meta-file validation failed:${NC}"
        echo "$meta_spec_output" | sed 's/^/   /'
        echo ""
        echo "   Fix the meta-file diagnostics listed above."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 17: ROADMAP regeneration trigger (arc-in-git only)
# ============================================================================
# When a staged meta file under active/ or backlog/planned/ changes a ROADMAP
# render field (Depends On / Owner / Cohort), backlog/ROADMAP.md should be
# re-rendered in the same commit (hand-maintenance per
# strategy-work-organization.md § ROADMAP). Field-specific by design: lifecycle
# ceremonies change State and paths, not these fields, and regen via their own
# dedicated step — so they never trip this check. Warn-only: a manual re-render
# is multi-step, so this nudges rather than blocks.
pm_mode=$(arc_config_get "pm.mode" "none")

if [ "$pm_mode" = "arc-in-git" ]; then
    roadmap_staged=$(git diff --cached --name-only --diff-filter=ACMR | \
        grep -E '^\.arc/backlog/ROADMAP\.md$' || true)

    if [ -z "$roadmap_staged" ]; then
        roadmap_field_changes=$(git diff --cached --name-only --diff-filter=ACMR | \
            grep -E '^\.arc/(active|backlog/planned)/([^/]+/)*meta-[^/]+\.md$' | \
            while IFS= read -r file; do
                if git diff --cached -U0 -- "$file" 2>/dev/null | \
                    grep -qE '^[-+][[:space:]]*-[[:space:]]+\*\*(Depends On|Owner|Cohort):\*\*'; then
                    echo "$file"
                fi
            done)

        if [ -n "$roadmap_field_changes" ]; then
            echo -e "${YELLOW}Warning: ROADMAP render fields changed without re-rendering backlog/ROADMAP.md:${NC}"
            echo "$roadmap_field_changes" | sed 's/^/   /'
            echo "   Depends On / Owner / Cohort feed the ROADMAP render."
            echo "   Re-render with: arc status --project --staged > .arc/backlog/ROADMAP.md"
            echo "   Then stage .arc/backlog/ROADMAP.md."
            echo "   (Lifecycle ceremonies regen via their own step — disregard if this is one.)"
            warnings=$((warnings + 1))
        fi
    fi
fi

# ============================================================================
# CHECK 18: Cohort-consistency invariant (backlog-scoped)
# ============================================================================
# Validates the three-condition cohort-consistency invariant over staged
# work-unit metas and cohort docs under `.arc/backlog/planned/`: (a) a WU's
# `**Cohort:**` field path-matches its filed dir; (b) every grouping dir carries
# a `cohort-<leaf>.md` with a `Purpose` floor; (c) a cohort doc's per-member
# section slugs are a subset of derived members. Staged-scoped — the validator's
# universe is the staged delta, so it never audits the live backlog (pre-existing
# divergence is a separate sweep's concern, not this gate's).
cohort_consistency_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^\.arc/backlog/planned/([^/]+/)*(meta|cohort)-[^/]+\.md$' || true)

if [ -n "$cohort_consistency_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    if ! cohort_consistency_output=$(npx tsx packages/arc-framework/src/scripts/validate-cohort-consistency.ts $cohort_consistency_candidates 2>&1); then
        echo -e "${RED}Error: Cohort-consistency validation failed:${NC}"
        echo "$cohort_consistency_output" | sed 's/^/   /'
        echo ""
        echo "   Fix the field↔dir mismatch, missing cohort doc, or orphan section above."
        errors=$((errors + 1))
    fi
fi

# ============================================================================
# CHECK 19: ROADMAP regenerated assert (arc-in-git only)
# ============================================================================
# Validates a staged ROADMAP as a derived artifact: staged blob versus a fresh
# staged-index render, plus an unconditional conflict-marker scan. Mismatch
# rejects when the render snapshot is determinate; an indeterminate snapshot
# warns and allows. GitHub-side conflict resolution does not run local hooks;
# the next local commit that stages ROADMAP does.
if [ "$pm_mode" = "arc-in-git" ]; then
    roadmap_assert_candidate=$(git diff --cached --name-only --diff-filter=ACMR | \
        grep -E '^\.arc/backlog/ROADMAP\.md$' || true)

    if [ -n "$roadmap_assert_candidate" ]; then
        if ! roadmap_assert_output=$(npx tsx packages/arc-framework/src/scripts/assert-roadmap-regenerated.ts 2>&1); then
            echo -e "${RED}Error: ROADMAP is not regenerated from sources:${NC}"
            echo "$roadmap_assert_output" | sed 's/^/   /'
            errors=$((errors + 1))
        elif [ -n "$roadmap_assert_output" ]; then
            echo -e "${YELLOW}Warning: ROADMAP regeneration check is indeterminate:${NC}"
            echo "$roadmap_assert_output" | sed 's/^/   /'
            warnings=$((warnings + 1))
        fi
    fi
fi

# ============================================================================
# CHECK 20: Foreign-write advisory backstop
# ============================================================================
# Surfaces a staged per-WU artifact that another in-flight work unit also
# touches — a foreign-owned write about to land on the wrong branch. Reuses the
# `arc errand` overlap primitive over the locally-derived in-flight set (no
# network read at commit time). Scoped to the work-unit path surface; cohort
# docs and code fall to the behind-base net, not this single-owner gate.
# Advisory: it WARNS and never blocks, and the entrypoint fails open (exit 0,
# no output) on any degraded state.
foreign_write_candidates=$(git diff --cached --name-only --diff-filter=ACMR | \
    grep -E '^\.arc/(active|backlog)/([^/]+/)*(meta|spec|draft|tasks|notes)-[^/]+\.md$' || true)

if [ -n "$foreign_write_candidates" ]; then
    # shellcheck disable=SC2086 # Intentional word splitting — newline-separated paths
    foreign_write_output=$(npx tsx packages/arc-framework/src/scripts/check-foreign-writes.ts $foreign_write_candidates 2>/dev/null || true)
    if [ -n "$foreign_write_output" ]; then
        echo -e "${YELLOW}Warning: In-flight artifact advisory:${NC}"
        echo "$foreign_write_output" | sed 's/^/   /'
        echo ""
        echo "   Review the advisory lines above. Coordinate or sequence when needed;"
        echo "   advisory only, the commit proceeds."
        warnings=$((warnings + 1))
    fi
fi

# ============================================================================
# Summary
# ============================================================================
echo ""
if [ $errors -gt 0 ]; then
    echo -e "${RED}Pre-commit checks FAILED with $errors error(s) and $warnings warning(s)${NC}"
    echo ""
    echo "Fix the issues above and retry."
    exit 1
elif [ $warnings -gt 0 ]; then
    echo -e "${GREEN}Pre-commit checks PASSED with $warnings warning(s)${NC}"
    exit 0
else
    echo -e "${GREEN}Pre-commit checks PASSED${NC}"
    exit 0
fi
