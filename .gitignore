# ARC Development System - .gitignore

# NPX cache (optional - can be cleaned with npx --clear-cache)
.npm/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# Temporary files
*.tmp
*.temp
*.log

# vscode settings
.vscode/

# AI tool settings (personal development environment preferences)
.claude/settings.local.json
.warp/

# explicitly temp-flagged internal docs
.arc/**/temp-*

# User directory contents (personal workspace, gitignored)
# Local dependencies
node_modules/
.arc/system/.internal/pristine.json
.arc/user/*/
.claude/skills/arc-*/
.codex/skills/arc-*/
