# ARC Framework dev repo - .gitignore

# NPX cache (optional - can be cleaned with npx --clear-cache)
.npm/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Temporary files
*.tmp
*.temp
*.log

# AI tool settings (personal development environment preferences)
.claude/settings.local.json
.warp/

# explicitly temp-flagged internal docs
.arc/**/temp-*

# MkDocs build output
site/

# Local dependencies
node_modules/

# ARC Framework (managed by arc cli)
.arc/system/.internal/pristine.json
.arc/user/*/
.claude/skills/arc-*/
.codex/skills/arc-*/
# end ARC
