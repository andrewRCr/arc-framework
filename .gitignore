# ARC Development System - .gitignore

# NPX cache (optional - can be cleaned with npx --clear-cache)
.npm/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# Temporary files
*.tmp
*.temp
*.log

# vscode settings
.vscode/

# AI tool settings (personal development environment preferences)
.claude/settings.local.json
.warp/

# explicitly temp-flagged internal docs
.arc-internal/**/temp-*

# Session context (personal, gitignored per ADR-007)
.arc-internal/active/SESSION.md
.arc-internal/team/*/SESSION.md
# Local dependencies
node_modules/
