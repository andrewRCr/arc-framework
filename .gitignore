# ARC Development System - .gitignore

# NPX cache (optional - can be cleaned with npx --clear-cache)
.npm/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# Temporary files
*.tmp
*.temp
*.log

# vscode settings
.vscode/

# AI tool settings (personal development environment preferences)
.claude/
.warp/

# Personal reference documentation and notes (work-in-progress only)
.arc-internal/active/*/notes-*
.arc-internal/active/*/research-*
.arc-internal/upcoming/notes/

# Session handoff file (transient)
.arc-internal/active/CURRENT-SESSION.md