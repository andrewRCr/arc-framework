# ARC Development System - .gitignore

# Temporal development workspace files
.arc-internal/active/CURRENT-SESSION.md
.arc-internal/active/*/notes-*
.arc-internal/upcoming/notes/
.arc-internal/reference/archive/notes/

# NPX cache (optional - can be cleaned with npx --clear-cache)
.npm/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# Temporary files
*.tmp
*.temp
*.log